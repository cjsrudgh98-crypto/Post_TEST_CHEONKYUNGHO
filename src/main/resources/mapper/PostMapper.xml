<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.post.mapper.PostMapper">

    <!-- 게시글 목록 -->
    <select id="list" resultType="Post">
        SELECT *
        FROM post
        ORDER BY post_no DESC
    </select>

    <!-- 게시글 목록 - [페이징] -->
    <select id="page" resultType="Post">
        SELECT *
        FROM post
        ORDER BY post_no DESC
        LIMIT #{index}, #{size}
    </select>

    <!-- 게시글 수 -->
    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM post
    </select>

    <!-- 게시글 조회 -->
    <select id="select" resultType="Post">
        SELECT *
        FROM post
        WHERE post_no = #{postNo}
    </select>

    <!-- 게시글 등록 -->
    <insert id="insert" parameterType="Post" useGeneratedKeys="true" keyProperty="postNo">
        INSERT INTO post (title, writer, content)
        VALUES (#{title}, #{writer}, #{content})
    </insert>

    <!-- 게시글 수정 -->
    <update id="update" parameterType="Post">
        UPDATE post
           SET title    = #{title}
              ,writer   = #{writer}
              ,content  = #{content}
              ,upd_date = now()
         WHERE post_no = #{postNo}
    </update>

    <!-- 게시글 삭제 -->
    <delete id="delete">
        DELETE FROM post
        WHERE post_no = #{postNo}
    </delete>

</mapper>
